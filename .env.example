# --- Backend Configuration ---
PORT=5000
NODE_ENV=development

# MongoDB operational connection URI
MONGO_URI=mongodb://localhost:27017/careerpilot

# Cryptographic token secret keys
JWT_ACCESS_SECRET=your_jwt_access_secret_key_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_string

# Gemini Developer Platform Key
GEMINI_API_KEY=your_gemini_api_key_from_google_developer_console

# --- Client Configurations ---
CLIENT_URL=http://localhost:5173
